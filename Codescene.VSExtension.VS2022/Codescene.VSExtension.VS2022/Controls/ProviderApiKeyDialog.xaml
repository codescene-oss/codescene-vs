<platformUi:DialogWindow x:Class="Codescene.VSExtension.VS2022.Controls.ProviderApiKeyDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Refactoring Agent API key"
                       Width="500"
                       Height="350"
                       WindowStartupLocation="CenterOwner"
                       ShowInTaskbar="False"
                       ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select provider:" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" x:Name="ProviderListBox" Margin="0,0,0,10"
                 SelectionChanged="ProviderListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Provider.Label}" Width="200"/>
                        <TextBlock Text="Key stored" Foreground="Green" Visibility="{Binding KeyStoredVisibility}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="API key:" Margin="0,0,0,5"/>

        <PasswordBox Grid.Row="3" x:Name="ApiKeyPasswordBox" Margin="0,0,0,5"
                     PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="4" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="Gray"
                   Text="The key is encrypted for your Windows account. Leave empty to remove the stored key."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,35,0,0">
            <Button x:Name="OkButton" Content="OK" Width="75" Margin="0,0,10,0" IsDefault="True" IsEnabled="False"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="75" IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
