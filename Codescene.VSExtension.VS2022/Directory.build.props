<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RunStyleCopAnalyzers>true</RunStyleCopAnalyzers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Codescene.VSExtension.Core' Or '$(AssemblyName)' == 'Codescene.VSExtension.VS2022'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build\StrongName\Codescene.VSExtension.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Codescene.VSExtension.Core.Tests' Or '$(MSBuildProjectName)' == 'Codescene.VSExtension.Core.IntegrationTests' Or '$(MSBuildProjectName)' == 'Codescene.VSExtension.Core.SubcutaneousTests'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build\StrongName\TestFriends.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)\stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
